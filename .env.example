# .env.example - variables de entorno de ejemplo para docker-compose

# PostgreSQL
POSTGRES_DB=api_recetas_postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_secure_password

# App
APP_CORS_ALLOWED_ORIGINS=http://localhost
APP_RECETA_DEL_DIA_SEED=recetas_demo_seed
JWT_SECRET=replace_with_a_secure_random_value
JWT_EXPIRATION_MS=3600000

# Opcional: Stripe (usar claves de prueba de Stripe si quieres integrar pagos reales)
# Obtén claves de prueba en https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
DONATION_SUCCESS_URL=http://localhost:8080/donacion/success
DONATION_CANCEL_URL=http://localhost:8080/donacion/cancel
